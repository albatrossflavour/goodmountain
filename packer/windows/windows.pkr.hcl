# Windows Server templates for igor, built from the workstation by
# packer-windows.sh. The proxmox plugin reads PROXMOX_URL, PROXMOX_USERNAME,
# and PROXMOX_TOKEN from the environment itself (op run puts them there), so
# nothing here holds or names a credential beyond the throwaway build
# credential, which packer-windows.sh generates and the build disables.
#
# The template carries cloudbase-init, reading a Proxmox configdrive2 drive,
# the virtio drivers, and the guest agent. WinRM is on only while Packer
# builds, and finalise.ps1 removes it before sysprep.

packer {
  required_version = ">= 1.16.0"

  required_plugins {
    proxmox = {
      source  = "github.com/hashicorp/proxmox"
      version = "= 1.2.4"
    }
  }
}

variable "vm_id" {
  description = "The template's VMID: calculate_base_id Windows <version>, times ten."
  type        = number
}

variable "template_name" {
  description = "template-Windows-<version>, the name igor clones."
  type        = string
}

variable "iso_file" {
  description = "The Evaluation Center ISO, staged on luggage as <storage>:iso/<file>."
  type        = string
}

variable "iso_checksum" {
  description = "sha256:<hex> of that ISO, which packer-windows.sh checks on the node before building."
  type        = string
}

variable "image_index" {
  description = "The install.wim image: 2 is Standard Evaluation with Desktop Experience."
  type        = number
  default     = 2
}

variable "virtio_os" {
  description = "The virtio-win driver folder for this version, such as 2k22."
  type        = string
}

variable "build_password" {
  description = "The build's Administrator password. Generated by packer-windows.sh, never printed, and the account is disabled before sysprep."
  type        = string
  sensitive   = true
}

variable "node" {
  description = "The Proxmox node that builds the template, where igor clones from."
  type        = string
  default     = "ankh"
}

locals {
  # virtio-win 0.1.302, staged on luggage from Fedora's archive
  # (https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win-0.1.302.iso).
  # Fedora publishes no sha256, so this is the hash of the copy downloaded over
  # HTTPS on 2026-11-20. packer-windows.sh checks the staged copy against it.
  virtio_iso_file     = "luggage:iso/virtio-win-0.1.302.iso"
  virtio_iso_checksum = "sha256:303f7ae40dad495d6ae474fdc571df58958a4dbc5c37a522d80f9a203867949d"

  # cloudbase-init 1.1.9, with the digest GitHub publishes for the release asset.
  cloudbase_init_msi_url      = "https://github.com/cloudbase/cloudbase-init/releases/download/1.1.9/CloudbaseInitSetup_1_1_9_x64.msi"
  cloudbase_init_msi_checksum = "sha256:ffbf80515a7311ed00800276a6af7aab23b41d7acf13e79ce3d2d56844f638f7"
}

source "proxmox-iso" "windows" {
  insecure_skip_tls_verify = false
  node                     = var.node
  vm_id                    = var.vm_id
  vm_name                  = var.template_name
  template_name            = var.template_name
  template_description     = "Windows Server template with cloudbase-init (configdrive2), built by goodmountain's packer-windows.sh. No credentials."

  machine         = "q35"
  bios            = "ovmf"
  os              = "win11"
  cpu_type        = "x86-64-v3"
  cores           = 2
  memory          = 4096
  scsi_controller = "virtio-scsi-single"
  qemu_agent      = true

  efi_config {
    efi_storage_pool  = "ceph"
    efi_type          = "4m"
    pre_enrolled_keys = true
  }

  tpm_config {
    tpm_storage_pool = "ceph"
    tpm_version      = "v2.0"
  }

  disks {
    type         = "scsi"
    disk_size    = "40G"
    storage_pool = "ceph"
    format       = "raw"
    cache_mode   = "writeback"
    discard      = true
    io_thread    = true
    ssd          = true
  }

  network_adapters {
    bridge   = "vmbr1"
    model    = "virtio"
    vlan_tag = "7"
  }

  # Both ISOs are staged on luggage rather than downloaded by the node, whose
  # download-url refuses a file that already exists, so a second build or a
  # rebuild would fail. The plugin doesn't check a staged ISO, so
  # packer-windows.sh hashes each one on the node before building.
  boot_iso {
    type     = "sata"
    index    = 0
    iso_file = var.iso_file
    unmount  = true
  }

  additional_iso_files {
    type     = "sata"
    index    = 1
    iso_file = local.virtio_iso_file
    unmount  = true
  }

  # The answer CD: autounattend.xml, the build scripts, and cloudbase-init's
  # config. It holds the build's credential, so it is uploaded for the build only
  # and removed with the drive.
  additional_iso_files {
    type             = "sata"
    index            = 2
    iso_storage_pool = "local"
    unmount          = true
    cd_label         = "PACKER"
    cd_files         = ["${path.root}/scripts/*", "${path.root}/cloudbase-init/*"]
    cd_content = {
      "autounattend.xml" = templatefile("${path.root}/answer/autounattend.xml.pkrtpl", { build_password = var.build_password, image_index = var.image_index, virtio_os = var.virtio_os })
    }
  }

  # UEFI asks for a key press before booting the Windows CD.
  boot_wait    = "3s"
  boot_command = ["<enter><wait><enter><wait><enter>"]

  # HTTP with basic auth on the lab VLAN, for the build's life only.
  communicator   = "winrm"
  winrm_username = "Administrator"
  winrm_password = var.build_password
  winrm_use_ssl  = false
  winrm_insecure = false
  winrm_timeout  = "2h"
}

build {
  sources = ["source.proxmox-iso.windows"]

  provisioner "powershell" {
    script = "${path.root}/scripts/install-guest-tools.ps1"
  }

  provisioner "powershell" {
    script = "${path.root}/scripts/install-cloudbase-init.ps1"
    environment_vars = [
      "CLOUDBASE_INIT_MSI_URL=${local.cloudbase_init_msi_url}",
      "CLOUDBASE_INIT_MSI_CHECKSUM=${local.cloudbase_init_msi_checksum}",
    ]
  }

  # Hands sysprep to a detached process and returns, since sysprep shuts the
  # VM down and WinRM goes with it.
  provisioner "powershell" {
    script = "${path.root}/scripts/finalise.ps1"
  }

  # Waits for sysprep to power the VM off, so the plugin's own shutdown (a
  # no-op on a stopped VM) never interrupts it before the template is made.
  provisioner "shell-local" {
    script           = "${path.root}/wait-stopped.sh"
    environment_vars = ["VMID=${var.vm_id}", "NODE=${var.node}"]
  }
}
